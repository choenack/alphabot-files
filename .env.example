# ─────────────────────────────────────────────────────────────
#  coin ai 설정 파일(.env)
#  · coin-ai.exe 사용 시: 대시보드 '설정' 탭에서 입력하면 이 파일이 자동으로 만들어져요.
#  · 파이썬 버전 사용 시: install.bat 을 실행하면 .env 가 만들어지고 메모장이 열려요.
#  .env 에는 비밀키가 들어가니 절대 남에게 보내거나 인터넷에 올리지 마세요.
# ─────────────────────────────────────────────────────────────

# [필수] 업비트 Open API 키 — 업비트 > 마이페이지 > Open API 관리
#   권한: '자산조회' + '주문조회' + '주문하기' 만 체크. '출금하기'는 절대 체크하지 마세요.
#   허용 IP: 이 PC의 인터넷 IP를 등록(네이버에서 '내 IP' 검색). IP가 바뀌면 다시 등록해야 합니다.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# [필수] DeepSeek API 키 — platform.deepseek.com (매매 판단용, 월 수천 원 수준)
DEEPSEEK_API_KEY=

# [선택] Claude API 키 — console.anthropic.com
#   DeepSeek 장애 시 예비 판단(Sonnet 5.5) + 월 1회 자가진화(Fable 5.1). 없으면 두 기능만 꺼집니다.
ANTHROPIC_API_KEY=

# [선택] 텔레그램 알림 — @BotFather 로 봇을 만들고 토큰, 내 chat id 를 넣으면 휴대폰으로 알림이 옵니다.
TG_TOKEN=
TG_CHAT=

# ── 운용 금액 ─────────────────────────────────────────────────
# 계좌에 돈이 더 있어도 봇은 이 금액(+봇이 번 수익)까지만 씁니다. 직접 산 코인은 건드리지 않습니다.
MAX_CAPITAL_KRW=100000

# ── 아래는 바꾸고 싶을 때만 (기본값 = 공격적 세팅) ───────────────
# UNIVERSE_SIZE=30            # 감시 코인 수(거래대금 상위)
# MAX_POSITIONS=3             # 동시 보유 최대
# MAX_POSITION_PCT=0.45       # 코인당 최대 비중
# RISK_HIGH=0.03              # LLM 확신 high일 때 1회 위험(손절 시 운용금의 3%)
# RISK_NORMAL=0.015           # 확신 normal일 때 1.5%
# DAILY_LOSS_LIMIT=0.08       # 하루 -8%면 그날 신규 진입 중지
# TOTAL_STOP_DD=0.25          # 시작금 대비 -25%면 봇 정지
# TRAIL_ATR=3.0               # 트레일링 폭(1시간 ATR 배수)
# DEEPSEEK_THINKING=disabled  # enabled 로 바꾸면 생각 모드(판단 품질↑, 비용 3~4배, 몇 초 느림)
# DEEPSEEK_EFFORT=low
# EVOLVE_ENABLED=1            # 0이면 자가진화 끔
